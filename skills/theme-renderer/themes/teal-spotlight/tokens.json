{
  "theme": "teal-spotlight",
  "colors": {
    "ground": "#0A1F24",
    "accent": "#14B8A6",
    "glow": "#11505A",
    "highlight": "#FFC83D",
    "text": "#F7FAF9",
    "pop": "#FFC83D",
    "mint": "#A7F3D0",
    "deep": "#11505A",
    "shadow": "#03100F",
    "ink": "#0F2A30",
    "card": "#FFFFFF",
    "card_line": "#CFE3E0",
    "skeleton": "#E3ECEB",
    "wash_a": "#D5F7EA",
    "wash_b": "#D7ECFA",
    "wash_c": "#E6DDFB"
